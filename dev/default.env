# Defaults of the dev environment: fixed ports, no tooling needed.
# `npm run dev-deps` copies this file to .env when there is none; .env overrides it
# (it is never overwritten, edit it freely).
# Ports stay in 6050-6099 so that they rarely collide with other local services (6000 is refused by browsers).
DEV_HOST=localhost
# the dev servers and mocks are on loopback: allowed to the SSRF-safe http clients of the api and the tests
SSRF_PUBLIC_IPS=127.0.0.1,::1
# 4 nginx servers for the multi-site tests: the dev host, two other origins and a site under a path prefix
NGINX_PORT1=6050
NGINX_PORT2=6051
NGINX_PORT3=6052
NGINX_PORT4=6053
DEV_API_PORT=6054
DEV_UI_PORT=6055
DEV_UI_HMR_PORT=6056
DEV_OBSERVER_PORT=6057
MAILDEV_UI_PORT=6058
MAILDEV_SMTP_PORT=6059
MONGO_PORT=6060
# identity providers: ldap and the two mock OIDC servers of dev/mock-oidc-server.ts serve the tests; oidc-provider,
# keycloak and the compose profiles saml-provider and ldap-admin are for manual checks
LDAP_PORT=6061
LDAP_ADMIN_PORT=6062
OIDC_PROVIDER_PORT=6063
KEYCLOAK_PORT=6064
MOCK_OIDC_PORT1=6065
MOCK_OIDC_PORT2=6066
MOCK_OIDC_CONTROL_PORT1=6067
MOCK_OIDC_CONTROL_PORT2=6068
# optional: empty turns the events integration off. To turn it on, set EVENTS_PORT=6069 and start the
# compose profile events (npm run dev -- --profile events)
EVENTS_PORT=
