// Dev environment of simple-directory, see @data-fair/lib-dev. Agents: npx --no df-dev status | logs <pane> | restart <pane>
layout {
  pane split_direction="vertical" {
    pane name="simple-directory" borderless=true
    pane name="status" command="./node_modules/.bin/df-status" {
      args "--start-deps"
    }
    pane name="mock-oidc" command="bash" {
      args "-c" "FORCE_COLOR=1 exec ./node_modules/.bin/nodemon --watch dev/mock-oidc-server.ts --exec node dev/mock-oidc-server.ts"
    }
  }
  pane split_direction="vertical" {
    pane name="ui" command="bash" {
      args "-c" "export NODE_CONFIG=$(./node_modules/.bin/df-dev absent-config) && cd ui && FORCE_COLOR=1 NODE_CONFIG_DIR=../api/config/ exec ../node_modules/.bin/df-mem-cap vite --configLoader native --port $DEV_UI_PORT"
    }
    pane name="api" command="bash" {
      args "-c" "./node_modules/.bin/df-dev wait-deps && export NODE_CONFIG=$(./node_modules/.bin/df-dev absent-config) && cd api && FORCE_COLOR=1 NODE_ENV=development ENABLE_TEST_API=1 IGNORE_ASSERT_REQ_INTERNAL=1 DEBUG='upgrade*' exec ../node_modules/.bin/nodemon -e js,ts,json,cjs,html index.ts"
    }
  }
  pane name="url" size=1 borderless=true command="bash" {
    args "-c" "echo -n -e \"Dev server available at \\e[1;96mhttp://$DEV_HOST:$NGINX_PORT1/simple-directory/\\e[0m\"; exec sleep infinity"
  }
}
