{
  "name": "simple-directory",
  "version": "8.23.0",
  "description": "Easy users and organizations management for modern Web-oriented architectures.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test-unit": "npm run test -- --project=unit",
    "test-api": "npm run test -- --project=api",
    "test-api-fast": "npm run test -- --project=api --max-failures=1",
    "test-inproc": "npm run test -- --project=api-inproc-ldap --project=api-inproc-oidc",
    "test-e2e": "npm run test -- --project=e2e",
    "lint": "eslint . && npm -w ui run lint",
    "lint-fix": "eslint --fix . && npm -w ui run lint-fix",
    "dev-fixtures": "dotenv -- node --experimental-strip-types --disable-warning=ExperimentalWarning dev/fixtures.ts",
    "dev-zellij": "df-dev zellij",
    "stop-dev-deps": "docker compose --profile '*' stop",
    "build-types": "mkdir -p ui/src/components/vjsf && rm -f ui/src/components/vjsf/* && rm -rf node_modules/.cache/@data-fair/lib-types-builder && df-build-types . --vjsf-dir ui/src/components/vjsf",
    "prepare": "husky || true",
    "check-types": "tsc && npm -w ui run check-types",
    "quality": "npm run lint && npm run build-types && npm -w ui run build && npm run check-types && npm run test && npm audit --omit=dev --audit-level=critical"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/data-fair/simple-directory.git"
  },
  "workspaces": [
    "ui",
    "api",
    "shared"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/data-fair/simple-directory/issues"
  },
  "homepage": "https://github.com/data-fair/simple-directory#readme",
  "engines": {
    "node": ">=24.22.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@data-fair/lib-dev": "^0.1.0",
    "@data-fair/lib-express": "^1.33.0",
    "@data-fair/lib-node": "^2.17.0",
    "@data-fair/lib-utils": "^1.14.1",
    "@json-layout/core": "~2.12.1",
    "@playwright/test": "^1.59.1",
    "@types/accept-language-parser": "^1.5.8",
    "@types/capitalize": "^2.0.2",
    "@types/config": "^3.3.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cookies": "^0.9.2",
    "@types/ldapjs": "^3.0.6",
    "@types/material-colors": "^1.2.3",
    "@types/memoizee": "^0.4.12",
    "@types/mjml": "^4.7.4",
    "@types/ms": "^2.1.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.13.0",
    "@types/serialize-javascript": "^5.0.4",
    "@types/simple-oauth2": "^5.0.8",
    "commitlint": "^19.8.1",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuetify": "^2.7.3",
    "husky": "^9.1.7",
    "neostandard": "^0.14.1",
    "nodemon": "^3.1.14",
    "oauth2-mock-server": "^9.2.0",
    "tough-cookie": "^5.1.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@data-fair/lib-types-builder": "^1.14.5",
    "@koumoul/vjsf-compiler": "^1.4.0",
    "@types/debug": "^4.1.13",
    "ajv": "^8.17.1"
  },
  "relativeDependencies": {
    "@data-fair/lib-vuetify": "../lib/packages/vuetify",
    "@data-fair/lib-vue": "../lib/packages/vue"
  }
}
